{
  "title": "Add Order",
  "columns": [
    {
      "name": "order-form",
      "size": {
        "xl": 12,
        "lg": 12,
        "md": 12,
        "sm": 12
      },
      "type": "form",
      "content": {
        "id": "form2",
        "formApi": {
          "getUrl": "orders-data",
          "postUrl": "orders-data",
          "updateUrl": "orders-data/<id>"
        },
        "fields": [
          {
            "type": "textbox",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "inputType": "text",
              "name": "order",
              "placeholder": "#000000",
              "position": "horizontal",
              "value": "",
              "title": {
                "text": "Order"
              },
              "validation": {
                "required": true,
                "type_check": true
              },
              "onError": {
                "position": "below",
                "message": {
                  "required": "Order number is required",
                  "type_check": "Invalid order number format"
                }
              }
            }
          },
          {
            "type": "textbox",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "inputType": "text",
              "name": "customer",
              "placeholder": "Enter customer name",
              "position": "horizontal",
              "value": "",
              "title": {
                "text": "Customer"
              },
              "validation": {
                "required": true,
                "type_check": true
              },
              "onError": {
                "position": "below",
                "message": {
                  "required": "Customer name is required",
                  "type_check": "Invalid name format"
                }
              }
            }
          },
          {
            "type": "dropdown",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "position": "horizontal",
              "name": "channel",
              "value": "",
              "title": {
                "text": "Channel"
              },
              "options": [
                { "value": "TikTok", "label": "TikTok" },
                { "value": "Instagram", "label": "Instagram" },
                { "value": "Facebook", "label": "Facebook" }
              ],
              "validation": {
                "required": true
              }
            }
          },
          {
            "type": "textbox",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "inputType": "text",
              "placeholder": "$0.00",
              "position": "horizontal",
              "name": "total",
              "value": "",
              "title": {
                "text": "Total"
              },

              "validation": {
                "required": true,
                "type_check": true
              },

              "onError": {
                "position": "below",
                "message": {
                  "required": "Total amount is required",
                  "type_check": "Invalid amount format"
                }
              }
            }
          },
          {
            "type": "dropdown",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "position": "horizontal",
              "name": "payment_status",
              "value": "",
              "title": {
                "text": "Payment Status"
              },
              "options": [
                { "value": "Paid", "label": "Paid" },
                { "value": "Unpaid", "label": "Unpaid" }
              ],
              "validation": {
                "required": true
              }
            }
          },
          {
            "type": "dropdown",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "position": "horizontal",
              "name": "fulfillment_status",
              "value": "",
              "title": {
                "text": "Fulfillment Status"
              },
              "options": [
                { "value": "Pending", "label": "Pending" },
                { "value": "In Progress", "label": "In Progress" },
                { "value": "Shipped", "label": "Shipped" },
                { "value": "Fulfilled", "label": "Fulfilled" },
                { "value": "Cancelled", "label": "Cancelled" }
              ],
              "validation": {
                "required": true
              }
            }
          },
          {
            "type": "textbox",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "inputType": "number",
              "position": "horizontal",
              "name": "items",
              "value": "",
              "title": {
                "text": "Items"
              },
              "placeholder": "Enter number of items",
              "validation": {
                "required": true,
                "type_check": true
              },

              "onError": {
                "message": {
                  "required": "Number of items is required",
                  "type_check": "Invalid number format"
                },
                "position": "below"
              }
            }
          },
          {
            "type": "dropdown",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "position": "horizontal",
              "name": "delivery_status",
              "value": "",
              "title": {
                "text": "Delivery Status"
              },
              "options": [
                { "value": "Not Delivered", "label": "Not Delivered" },
                { "value": "In Transit", "label": "In Transit" },
                { "value": "Delivered", "label": "Delivered" }
              ],
              "validation": { "required": true }
            }
          },
          {
            "type": "textbox",
            "size": {
              "xl": 6,
              "lg": 6,
              "md": 12,
              "sm": 12
            },
            "content": {
              "inputType": "text",
              "name": "tags",
              "placeholder": "Enter tags",
              "position": "horizontal",
              "value": "",

              "title": {
                "text": "Tags"
              },

              "validation": {
                "required": false,
                "type_check": true
              },

              "onError": {
                "message": {
                  "type_check": "Invalid tag format"
                },
                "position": "below"
              }
            }
          }
        ]
      }
    }
  ],
  "buttons": [
    {
      "id": "form_clear",
      "type": "button",
      "text": "Clear",
      "theme": "btn_grey",
      "formId": "form2"
    },
    {
      "id": "form_save",
      "type": "button",
      "text": "Save Order",
      "theme": "btn_black",
      "path": "/orders",
      "formId": "form2"
    }
  ]
}
