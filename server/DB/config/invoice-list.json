{
  "buttons": [
    {
      "id": "navigate",
      "type": "button",
      "text": "Add Invoice",
      "theme": "btn_black",
      "path": "/invoices/add"
    },
    {
      "id": "export",
      "type": "button",
      "text": "Export",
      "theme": "btn_black"
    }
  ],
  "title": "Invoice Records",
  "rowLayouts": [
    {
      "columns": [
        {
          "size": {
            "xl": 12,
            "lg": 12,
            "md": 12,
            "sm": 12
          },
          "elements": [
            {
              "type": "table",
              "name": "invoice-records-table",
              "content": {
                "options": {
                  "title": {
                    "text": "Invoice Records"
                  },
                  "columns": [
                    {
                      "type": "text",
                      "label": "Invoice Number",
                      "name": "invoiceNumber",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": false,
                        "dropdownData": []
                      }
                    },
                    {
                      "type": "text",
                      "label": "Patient ID",
                      "name": "patientId",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": false,
                        "dropdownData": []
                      }
                    },
                    {
                      "type": "datetime",
                      "label": "Invoice Date",
                      "name": "invoiceDate",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": false,
                        "dropdownData": []
                      }
                    },
                    {
                      "type": "text",
                      "label": "Total Amount",
                      "name": "totalAmount",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": false,
                        "dropdownData": []
                      }
                    },
                    {
                      "type": "text",
                      "label": "Payment Status",
                      "name": "paymentStatus",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": true,
                        "dropdownData": ["Pending", "Paid", "Overdue"]
                      }
                    }
                  ],
                  "actions": {
                    "show": true,
                    "header": "Actions",
                    "buttons": ["view", "edit", "delete"]
                  }
                },
                "data": {
                  "url": "invoice-data"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
