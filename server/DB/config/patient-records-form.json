{
  "buttons": [
    {
      "id": "form_clear",
      "type": "button",
      "text": "Clear",
      "modes": ["add", "edit"],
      "style": {
        "backgroundColor": "#6c757d",
        "textColor": "#fff",
        "borderColor": "#6c757d",
        "boxShadow": "none",
        "gradient": "none"
      }
    },
    {
      "id": "form_cancel",
      "type": "button",
      "text": "Cancel",
      "modes": ["add", "edit", "view"],
      "style": {
        "backgroundColor": "#dc3545",
        "textColor": "#fff",
        "borderColor": "#dc3545",
        "boxShadow": "none",
        "gradient": "none"
      },
      "path": "/patients/records"
    },
    {
      "id": "form_save",
      "type": "button",
      "text": "Save",
      "modes": ["add", "edit"],
      "style": {
        "backgroundColor": "#000",
        "textColor": "#fff",
        "borderColor": "#000",
        "boxShadow": "none",
        "gradient": "none"
      },
      "path": "/patients/records"
    },
    {
      "id": "form_navigate",
      "type": "button",
      "text": "Add New Treatment",
      "modes": ["view"],
      "style": {
        "backgroundColor": "#007bff",
        "textColor": "#fff",
        "borderColor": "#007bff",
        "boxShadow": "none",
        "gradient": "none"
      },
      "path": "/patients/records/<patientId>/treatments/add"
    }
  ],
  "title": "Patient Record Details",
  "rowLayouts": [
    {
      "columns": [
        {
          "size": {
            "xl": 12,
            "lg": 12,
            "md": 12,
            "sm": 12
          },
          "elements": [
            {
              "name": "patient-record-form",
              "type": "form",
              "content": {
                "id": "patient-record-form",
                "formApi": {
                  "getUrl": "patient-records-data",
                  "postUrl": "patient-records-data",
                  "updateUrl": "patient-records-data/<id>"
                },
                "fields": [
                  {
                    "type": "textbox",
                    "content": {
                      "name": "patientId",
                      "inputType": "text",
                      "placeholder": "Enter patient ID",
                      "position": "horizontal",
                      "value": "",
                      "title": {
                        "text": "Patient ID"
                      },
                      "validation": {
                        "required": true,
                        "type_check": true
                      },
                      "onError": {
                        "position": "below",
                        "message": {
                          "required": "Patient ID is required",
                          "type_check": "Invalid format"
                        }
                      }
                    },
                    "size": {
                      "xl": 6,
                      "lg": 6,
                      "md": 12,
                      "sm": 12
                    }
                  },
                  {
                    "type": "textbox",
                    "content": {
                      "name": "PatientName",
                      "inputType": "text",
                      "placeholder": "Enter patient name",
                      "position": "horizontal",
                      "value": "",
                      "title": {
                        "text": "Patient Name"
                      },
                      "validation": {
                        "required": true,
                        "type_check": true
                      },
                      "onError": {
                        "position": "below",
                        "message": {
                          "required": "Patient Name is required",
                          "type_check": "Invalid format"
                        }
                      }
                    },
                    "size": {
                      "xl": 6,
                      "lg": 6,
                      "md": 12,
                      "sm": 12
                    }
                  },
                  {
                    "type": "dropdown",
                    "size": {
                      "xl": 6,
                      "lg": 6,
                      "md": 12,
                      "sm": 12
                    },
                    "content": {
                      "position": "horizontal",
                      "name": "Gender",
                      "value": "",
                      "title": {
                        "text": "Gender"
                      },
                      "options": [
                        { "value": "Male", "label": "Male" },
                        { "value": "Female", "label": "Female" },
                        { "value": "Other", "label": "Other" }
                      ],
                      "validation": {
                        "required": true
                      }
                    }
                  },
                  {
                    "type": "textbox",
                    "content": {
                      "name": "DateOfBirth",
                      "inputType": "date",
                      "placeholder": "Select date of birth",
                      "position": "horizontal",
                      "value": "",
                      "title": {
                        "text": "Date of Birth"
                      },
                      "validation": {
                        "required": true
                      },
                      "onError": {
                        "position": "below",
                        "message": {
                          "required": "Date of Birth is required"
                        }
                      }
                    },
                    "size": {
                      "xl": 6,
                      "lg": 6,
                      "md": 12,
                      "sm": 12
                    }
                  },
                  {
                    "type": "textbox",
                    "content": {
                      "name": "Age",
                      "inputType": "number",
                      "placeholder": "Enter age",
                      "position": "horizontal",
                      "value": "",
                      "title": {
                        "text": "Age"
                      },
                      "validation": {
                        "required": true,
                        "type_check": true
                      },
                      "onError": {
                        "position": "below",
                        "message": {
                          "required": "Age is required",
                          "type_check": "Invalid format"
                        }
                      }
                    },
                    "size": {
                      "xl": 6,
                      "lg": 6,
                      "md": 12,
                      "sm": 12
                    }
                  },

                  {
                    "type": "textbox",
                    "content": {
                      "name": "ContactNumber",
                      "inputType": "text",
                      "placeholder": "Enter contact number",
                      "position": "horizontal",
                      "value": "",
                      "title": {
                        "text": "Contact Number"
                      },
                      "validation": {
                        "required": true,
                        "type_check": true
                      },
                      "onError": {
                        "position": "below",
                        "message": {
                          "required": "Contact Number is required",
                          "type_check": "Invalid format"
                        }
                      }
                    },
                    "size": {
                      "xl": 6,
                      "lg": 6,
                      "md": 12,
                      "sm": 12
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "columns": [
        {
          "size": {
            "xl": 12,
            "lg": 12,
            "md": 12,
            "sm": 12
          },
          "elements": [
            {
              "type": "table",
              "content": {
                "options": {
                  "title": {
                    "text": "Treatment History"
                  },
                  "columns": [
                    {
                      "type": "datetime",
                      "label": "Treatment Date",
                      "name": "treatmentDate",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": false,
                        "dropdownData": []
                      }
                    },
                    {
                      "type": "text",
                      "label": "Treatment Type",
                      "name": "treatmentType",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": false,
                        "dropdownData": []
                      }
                    },
                    {
                      "type": "text",
                      "label": "Doctor",
                      "name": "doctor",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": false,
                        "dropdownData": []
                      }
                    },
                    {
                      "type": "text",
                      "label": "Notes",
                      "name": "notes",
                      "showSort": true,
                      "showFilter": true,
                      "filter": {
                        "showMenu": true,
                        "showDropdown": false,
                        "dropdownData": []
                      }
                    }
                  ],
                  "actions": {
                    "show": true,
                    "header": "Actions",
                    "buttons": ["view", "edit", "delete"]
                  }
                },
                "data": {
                  "url": "patient-treatment-data"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
